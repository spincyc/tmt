#!/bin/sh
# Test for tools/__TOOL_ID__: exit 0 = pass (the stable gate).
# Only --help exits 0 is universally guaranteed by the tool contract;
# every other assertion is tool-specific. Write real ones below — the
# stable gate refuses to promote while this file is the unmodified
# scaffold.
set -eu

# Resolved sibling path: keeps working after a cd into a sandbox.
tool="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/__TOOL_ID__"

# --help always works.
"$tool" --help >/dev/null

