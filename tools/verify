#!/usr/bin/env python3

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys


REPO_ROOT = Path(__file__).resolve().parent.parent
AGENTS_MAX_WORDS = 150
FRAGMENT_MAX_WORDS = 50


def run(
    command: list[str],
    *,
    environment: dict[str, str] | None = None,
) -> str:
    result = subprocess.run(
        command,
        cwd=REPO_ROOT,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode:
        output = result.stdout.strip()
        raise RuntimeError(
            f"command failed ({result.returncode}): {' '.join(command)}"
            + (f"\n{output}" if output else "")
        )
    return result.stdout


def check_bootstrap() -> None:
    source = (REPO_ROOT / "AGENTS.md").read_bytes()
    packaged = (REPO_ROOT / "src/tmt/_resources/AGENTS.md").read_bytes()
    if source != packaged:
        raise RuntimeError("packaged AGENTS.md differs from the canonical file")
    words = len(source.decode().split())
    if words > AGENTS_MAX_WORDS:
        raise RuntimeError(
            f"AGENTS.md has {words} words; maximum is {AGENTS_MAX_WORDS}"
        )


def check_fragment() -> None:
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.fspath(REPO_ROOT / "src"))
    try:
        from tmt.agentsmd import FRAGMENT
    finally:
        sys.path.pop(0)
    words = len(FRAGMENT.split())
    if words > FRAGMENT_MAX_WORDS:
        raise RuntimeError(
            f"AGENTS.md fragment has {words} words; "
            f"maximum is {FRAGMENT_MAX_WORDS}"
        )


def check_python() -> None:
    for path in sorted((REPO_ROOT / "src").rglob("*.py")):
        try:
            compile(path.read_bytes(), str(path.relative_to(REPO_ROOT)), "exec")
        except (SyntaxError, UnicodeError) as error:
            raise RuntimeError(f"{path.relative_to(REPO_ROOT)}: {error}") from error


def check_tracked_paths() -> None:
    tracked = [
        path
        for path in run(["git", "ls-files", "-z"]).split("\0")
        if path
    ]
    offenders = [
        path
        for path in tracked
        if path.endswith(".sqlite3")
        or "__pycache__" in path.split("/")
        or path == ".journal"
        or path.startswith(".journal/")
    ]
    if offenders:
        raise RuntimeError(f"private paths are tracked: {', '.join(offenders)}")


def check_tests() -> None:
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    source_path = str(REPO_ROOT / "src")
    existing_path = environment.get("PYTHONPATH")
    environment["PYTHONPATH"] = (
        f"{source_path}{os.pathsep}{existing_path}" if existing_path else source_path
    )
    run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
        environment=environment,
    )


def check_git_hygiene() -> None:
    run(["git", "diff", "--check"])


def check_sanity() -> None:
    run([str(REPO_ROOT / "tools" / "sanity-check")])


def main() -> int:
    try:
        check_sanity()
    except (OSError, RuntimeError) as error:
        print(f"FAIL check_sanity: {error}")
        return 1
    checks = (
        check_bootstrap,
        check_fragment,
        check_python,
        check_tracked_paths,
        check_tests,
        check_git_hygiene,
    )
    failures: list[str] = []
    for check in checks:
        try:
            check()
        except (OSError, RuntimeError, ValueError) as error:
            failures.append(f"{check.__name__}: {error}")
    if failures:
        for failure in failures:
            print(f"FAIL {failure}")
        return 1
    print("Verification passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
