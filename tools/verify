#!/usr/bin/env python3

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import tomllib


REPO_ROOT = Path(__file__).resolve().parent.parent
AGENTS_MAX_WORDS = 150
FRAGMENT_MAX_WORDS = 50
HELP_TEXT = (
    "Run every repository verification gate; fail on the first offender set.\n"
    "usage: tools/verify [--help]\n"
)
IGNORED_PREFIXES = ("build/", "dist/", ".journal/")


def run(
    command: list[str],
    *,
    environment: dict[str, str] | None = None,
) -> str:
    result = subprocess.run(
        command,
        cwd=REPO_ROOT,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if result.returncode:
        output = result.stdout.strip()
        raise RuntimeError(
            f"command failed ({result.returncode}): {' '.join(command)}"
            + (f"\n{output}" if output else "")
        )
    return result.stdout


def check_bootstrap() -> None:
    source = (REPO_ROOT / "AGENTS.md").read_bytes()
    packaged = (REPO_ROOT / "src/tmt/_resources/AGENTS.md").read_bytes()
    if source != packaged:
        raise RuntimeError("packaged AGENTS.md differs from the canonical file")
    words = len(source.decode().split())
    if words > AGENTS_MAX_WORDS:
        raise RuntimeError(
            f"AGENTS.md has {words} words; maximum is {AGENTS_MAX_WORDS}"
        )


def check_fragment() -> None:
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.fspath(REPO_ROOT / "src"))
    try:
        from tmt.agentsmd import FRAGMENT
    finally:
        sys.path.pop(0)
    words = len(FRAGMENT.split())
    if words > FRAGMENT_MAX_WORDS:
        raise RuntimeError(
            f"AGENTS.md fragment has {words} words; "
            f"maximum is {FRAGMENT_MAX_WORDS}"
        )


def check_python() -> None:
    for path in sorted((REPO_ROOT / "src").rglob("*.py")):
        try:
            compile(path.read_bytes(), str(path.relative_to(REPO_ROOT)), "exec")
        except (SyntaxError, UnicodeError) as error:
            raise RuntimeError(f"{path.relative_to(REPO_ROOT)}: {error}") from error


def check_tracked_paths() -> None:
    tracked = [
        path
        for path in run(["git", "ls-files", "-z"]).split("\0")
        if path
    ]
    offenders = [
        path
        for path in tracked
        if path.endswith(".sqlite3")
        or "__pycache__" in path.split("/")
        or path == ".journal"
        or path.startswith(IGNORED_PREFIXES)
        or any(part.endswith(".egg-info") for part in path.split("/"))
    ]
    if offenders:
        raise RuntimeError(
            f"private or generated paths are tracked: {', '.join(offenders)}"
        )


def check_version() -> None:
    with (REPO_ROOT / "pyproject.toml").open("rb") as handle:
        declared = tomllib.load(handle)["project"]["version"]
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.fspath(REPO_ROOT / "src"))
    try:
        from tmt import __version__
    finally:
        sys.path.pop(0)
    if declared != __version__:
        raise RuntimeError(
            f"pyproject version {declared!r} differs from "
            f"tmt.__version__ {__version__!r}"
        )


def source_environment() -> dict[str, str]:
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    source_path = str(REPO_ROOT / "src")
    existing_path = environment.get("PYTHONPATH")
    environment["PYTHONPATH"] = (
        f"{source_path}{os.pathsep}{existing_path}" if existing_path else source_path
    )
    return environment


def check_tests() -> None:
    run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
        environment=source_environment(),
    )


def check_registry() -> None:
    run(
        [sys.executable, "-m", "tmt", "check"],
        environment=source_environment(),
    )


def check_git_hygiene() -> None:
    run(["git", "diff", "--check"])


def check_sanity() -> None:
    run([str(REPO_ROOT / "tools" / "sanity-check")])


def in_git_work_tree() -> bool:
    """Whether git checks can run at all — an sdist is not a work tree."""
    try:
        return run(["git", "rev-parse", "--is-inside-work-tree"]).strip() == (
            "true"
        )
    except (OSError, RuntimeError):
        return False


def main(argv: list[str]) -> int:
    if "-h" in argv or "--help" in argv:
        print(HELP_TEXT, end="")
        return 0
    try:
        check_sanity()
    except (OSError, RuntimeError) as error:
        print(f"FAIL check_sanity: {error}")
        return 1
    checks = [
        check_bootstrap,
        check_fragment,
        check_python,
        check_version,
        check_registry,
        check_tests,
    ]
    git_checks = (check_tracked_paths, check_git_hygiene)
    if in_git_work_tree():
        checks.extend(git_checks)
    else:
        # An extracted sdist ships the suite but no repository; say which
        # gates therefore did not run rather than implying full coverage.
        skipped = ", ".join(check.__name__ for check in git_checks)
        print(f"SKIP {skipped}: not a git work tree")
    failures: list[str] = []
    for check in checks:
        try:
            check()
        except (OSError, RuntimeError, ValueError) as error:
            failures.append(f"{check.__name__}: {error}")
    if failures:
        for failure in failures:
            print(f"FAIL {failure}")
        return 1
    print("Verification passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
